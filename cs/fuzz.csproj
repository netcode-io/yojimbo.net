<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The fuzz targets (cpp/fuzz upstream). Like upstream's, they compile the library sources
    themselves instead of linking the library, so the netcode targets can reach the readers that
    are internal to netcode (upstream #includes netcode.c). Defines match yojimbo.csproj.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);YOJIMBO;YOJIMBO_ENABLE_LOGGING</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);YOJIMBO_DEBUG_MEMORY_LEAKS;YOJIMBO_DEBUG_MESSAGE_LEAKS;YOJIMBO_DEBUG_MESSAGE_BUDGET</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="fuzz/*.cs;include/*.cs;source/*.cs;netcode/*.cs;reliable/*.cs;serialize/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>
</Project>

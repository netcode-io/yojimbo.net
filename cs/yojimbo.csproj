<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- net10.0 for .NET apps, netstandard2.1 for Unity and other runtimes that only take .NET Standard -->
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <!-- Directory.Build.props sets a single TargetFramework for the programs; clear it so the list above applies -->
    <TargetFramework></TargetFramework>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!-- tracks upstream yojimbo: cpp/ is the submodule this version was ported from -->
    <Version>1.13.500</Version>
    <!-- yojimbo_config.h: logging is on by default; YOJIMBO tells reliable it is built into yojimbo -->
    <DefineConstants>$(DefineConstants);YOJIMBO;YOJIMBO_ENABLE_LOGGING</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- yojimbo_config.h: the debug checks are on in debug builds only -->
    <DefineConstants>$(DefineConstants);YOJIMBO_DEBUG_MEMORY_LEAKS;YOJIMBO_DEBUG_MESSAGE_LEAKS;YOJIMBO_DEBUG_MESSAGE_BUDGET</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <!-- NuGet package. The other projects in cs/ are programs and stay unpackable (Directory.Build.props). -->
    <IsPackable>true</IsPackable>
    <PackageId>yojimbo</PackageId>
    <Title>yojimbo</Title>
    <Authors>Glenn Fiedler;Sky Morey</Authors>
    <Description>C# port of yojimbo, a network library for client/server games with dedicated servers, with netcode and reliable built in. Speaks the netcode 1.02 wire protocol and interoperates with the C/C++ originals.</Description>
    <PackageTags>yojimbo;netcode;reliable;networking;udp;game;multiplayer</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/netcode-io/yojimbo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/netcode-io/yojimbo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Source Link (built into the .NET SDK): map the pdb to the commit on GitHub, ship symbols as a .snupkg -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="include/*.cs;source/*.cs;netcode/*.cs;reliable/*.cs;serialize/*.cs;netstandard.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>
</Project>
